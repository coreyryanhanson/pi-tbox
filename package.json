{
	"name": "pi-tbox",
	"version": "0.1.0",
	"description": "Cross-extension tool manager for Pi — list, toggle, group, focus, and count tools from any installed extension.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"tool-manager",
		"tbox"
	],
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/coreyryanhanson/pi-tbox.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./index.ts"
		}
	},
	"files": [
		"index.ts",
		"src/",
		"config/",
		"LICENSE",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"pi-tool-masking": "^1.0.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.78.0",
		"@types/node": "^22.0.0",
		"pi-tool-masking": "^1.0.0",
		"typescript": "^7.0.2",
		"vitest": "^4.0.0"
	}
}
